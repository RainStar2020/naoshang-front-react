# Browser requests stay same-origin; Vite forwards HQ requests to the chosen API server.
VITE_HQ_API_BASE_URL=/api/hq
# API 目标总开关：online = https://naoshang.chen1413.com.cn ；local = http://localhost:3000
# 改这一行即可切换本地联调后端（改完需重启 npm run dev）。
HQ_API_TARGET=online
# Optional: set only when H5 门店工作台接口 is served by a different backend.
# BUSINESS_API_PROXY_TARGET=https://naoshang.chen1413.com.cn
VITE_HQ_AUTH_MODE=api
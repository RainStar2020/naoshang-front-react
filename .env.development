# Browser requests stay same-origin; Vite forwards HQ requests to the local API server.
VITE_HQ_API_BASE_URL=/api/hq
HQ_API_PROXY_TARGET=http://192.168.0.44:3001
# Optional: set only when H5 门店工作台接口 is served by a different backend.
# BUSINESS_API_PROXY_TARGET=http://192.168.0.44:3001
VITE_HQ_AUTH_MODE=api
